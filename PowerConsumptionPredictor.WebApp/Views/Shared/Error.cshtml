@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-3xl px-4 mx-auto mt-10 sm:px-6 lg:px-8">
    <div class="overflow-hidden bg-white border-t-4 border-red-500 rounded-lg shadow-lg">
        <div class="p-6 sm:p-10">
            <h1 class="mb-2 text-3xl font-extrabold text-red-600">Error.</h1>
            <h2 class="mb-6 text-xl text-gray-700">Ha ocurrido un error al procesar tu solicitud.</h2>

            @if (Model.ShowRequestId)
            {
                <div class="p-4 mb-6 border border-red-100 rounded-md bg-red-50">
                    <p class="text-sm text-red-800">
                        <strong>Request ID:</strong>
                        <code
                        class="px-2 py-1 font-mono text-red-600 bg-white border border-red-200 rounded">@Model.RequestId</code>
                    </p>
                </div>
            }

            <div class="pt-6 mt-8 border-t border-gray-200">
                <h3 class="mb-3 text-lg font-semibold text-gray-900">Modo de Desarrollo</h3>
                <p class="mb-3 text-sm text-gray-600">
                    Cambiar al entorno de <strong class="text-gray-800">Development</strong> mostrará información más
                    detallada sobre el error que ocurrió.
                </p>
                <div class="p-4 text-sm text-gray-600 border border-gray-200 rounded-md bg-gray-50">
                    <p class="mb-2">
                        <strong class="text-gray-900">El entorno de Development no debe estar habilitado en
                            producción.</strong>
                            Puede resultar en la exposición de información sensible a través de las excepciones.
                        </p>
                        <p>
                            Para depuración local, habilita el entorno de desarrollo estableciendo la variable
                            <code
                            class="font-mono text-xs bg-gray-200 px-1 py-0.5 rounded text-gray-800">ASPNETCORE_ENVIRONMENT</code>
                            en <code
                            class="font-mono text-xs bg-gray-200 px-1 py-0.5 rounded text-gray-800">Development</code> y
                            reiniciando la app.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>