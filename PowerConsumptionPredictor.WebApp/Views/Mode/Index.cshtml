@model ModeSelectionViewModel
@{
    ViewData["Title"] = "Configuración de Modos";
}

<div class="max-w-2xl mx-auto mt-12">
    <div class="overflow-hidden bg-white border border-gray-100 shadow-xl rounded-2xl">
        <div class="px-8 py-6 bg-blue-600">
            <div class="flex flex-col items-start">

                <h2 class="text-2xl font-bold text-white">Algoritmo de Predicción</h2>
                <p class="text-sm text-blue-100">Escoge el modo de prediccion</p>
            </div>
        </div>

        <div class="p-8">
            <form asp-controller="Mode" asp-action="Index" method="post">
                <div class="mb-8">
                    <label asp-for="SelectedMode" class="block mb-3 text-sm font-semibold text-gray-700">
                        Modo de Prediccion Activo
                    </label>
                    <div class="relative">
                        <select asp-for="SelectedMode" asp-items="Html.GetEnumSelectList<PredictionMode>()"
                                class="block w-full p-4 text-sm text-gray-900 transition-all border border-gray-300 shadow-sm outline-none appearance-none cursor-pointer bg-gray-50 rounded-xl focus:ring-blue-500 focus:border-blue-500 hover:border-blue-300">
                        </select>
                        <div
                            class="absolute inset-y-0 right-0 flex items-center px-4 text-gray-500 pointer-events-none">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                    <span asp-validation-for="SelectedMode" class="block mt-2 text-xs text-red-500"></span>
                </div>

                <div class="flex items-center justify-between gap-4">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-sm font-medium text-gray-600 transition-colors hover:text-gray-800">
                        Cancelar y volver
                    </a>
                    <button type="submit"
                            class="px-10 py-3 font-bold text-white transition-all transform bg-blue-600 shadow-lg hover:cursor-pointer hover:bg-blue-700 rounded-xl shadow-blue-200 active:scale-95">
                        Guardar Configuración
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}