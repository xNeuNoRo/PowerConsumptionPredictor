@model LinearRegressionResultViewModel

<div
    class="p-6 border border-l-4 border-indigo-600 rounded-r-lg shadow-sm bg-indigo-50 border-y-indigo-100 border-r-indigo-100">
    <div class="flex items-center pb-3 mb-5 border-b border-indigo-200">
        <svg class="w-6 h-6 mr-2 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
        </svg>
        <h3 class="text-xl font-bold text-gray-800">
            Resultado: <span class="text-indigo-700">@Model.CalculationModeUsed</span>
        </h3>
    </div>

    <div class="grid grid-cols-1 gap-4 mb-5 md:grid-cols-2">
        <div class="p-5 bg-white border border-gray-100 rounded-md shadow-sm">
            <span class="block mb-2 text-sm font-medium text-gray-500">Consumo Predicho (Mes 13)</span>
            <span class="text-3xl font-black text-indigo-600">@Model.PredictedConsumption.ToString("F2") <span
                class="text-base font-bold text-gray-400">kWh</span></span>
            </div>

            <div class="flex flex-col justify-center p-5 bg-white border border-gray-100 rounded-md shadow-sm">
                <span class="block mb-2 text-sm font-medium text-gray-500">Pendiente Matemática (Slope)</span>
                <div class="flex items-center">
                    <span
                        class="text-2xl font-bold @(Model.Slope > 0 ? "text-red-600" : Model.Slope < 0 ? "text-green-600" : "text-gray-600")">
                        @Model.Slope.ToString("F4")
                    </span>

                    @if (Model.Slope > 0)
                    {
                        <svg class="w-6 h-6 ml-2 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                             xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                    }
                    else if (Model.Slope < 0)
                    {
                        <svg class="w-6 h-6 ml-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                             xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                  d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6"></path>
                        </svg>
                    }
                    else
                    {
                        <svg class="w-6 h-6 ml-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                             xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14"></path>
                        </svg>
                    }
                </div>
            </div>
        </div>

        <div class="flex items-start p-4 text-sm text-gray-700 border border-indigo-100 rounded-md bg-white/60">
            <svg class="h-5 w-5 text-indigo-500 mr-2 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                 fill="currentColor">
                <path fill-rule="evenodd"
                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z"
                      clip-rule="evenodd" />
            </svg>
            <p>
                <strong class="font-semibold text-gray-900">Análisis:</strong> @Model.InterpretationMessage
            </p>
        </div>
    </div>